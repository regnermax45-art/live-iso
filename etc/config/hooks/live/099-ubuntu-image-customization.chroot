#!/bin/bash -ex

# MaxregnerOS Revolutionary UI - Image customization
if [ "$IMAGEFORMAT" == "none" ]; then
    if [ "$SUBPROJECT" == "desktop-preinstalled" ]; then
        mkdir -p /var/log/installer
        mkdir -p /var/log/maxregneros
        touch /var/log/installer/debug
        touch /var/log/syslog
        chown syslog:adm /var/log/syslog

        # Create the maxregner OEM user account with enhanced privileges
        /usr/sbin/useradd -d /home/maxregner -G adm,sudo -m -N -u 29999 -c "MaxregnerOS Administrator" maxregner

        /usr/sbin/oem-config-prepare --quiet
        touch "/var/lib/oem-config/run"

        # Make the writable partition grow
        echo "LABEL=writable    /     ext4    defaults,x-systemd.growfs    0 0" >>/etc/fstab

        # Create a 2GB swapfile for better performance
        dd if=/dev/zero of=/swapfile bs=1G count=2
        chmod 0600 /swapfile
        mkswap /swapfile

        echo "/swapfile         none  swap    sw    0 0" >>/etc/fstab
        
        # MaxregnerOS Revolutionary UI - Set system optimizations
        echo "vm.swappiness=10" >> /etc/sysctl.conf
        echo "vm.vfs_cache_pressure=50" >> /etc/sysctl.conf
    fi
fi
