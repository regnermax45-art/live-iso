#!/bin/sh
# Description: Set MaxregnerOS name and info with Revolutionary UI

# Prepare
distro_pretty_name="@DISTRO_NAME @VERSION @CHANNEL - Revolutionary UI Edition"

# Set OS name with stylish banner
echo "
╔══════════════════════════════════════════╗
║     🚀 MaxregnerOS Revolutionary UI     ║
║            Version @VERSION              ║
╚══════════════════════════════════════════╝
$distro_pretty_name /\n /\l" > /etc/issue

# Set OS info
echo 'PRETTY_NAME="'$distro_pretty_name'"
NAME="@DISTRO_NAME"
VERSION_ID="@VERSION"
VERSION="@VERSION @CHANNEL - Revolutionary UI"
VERSION_CODENAME="@CODENAME"
ID=maxregneros
ID_LIKE=debian
HOME_URL="https://github.com/regnermax45-art/maxregnerOS-manifest"
SUPPORT_URL="https://github.com/regnermax45-art"
BUG_REPORT_URL="https://github.com/regnermax45-art/maxregnerOS-manifest/issues"
DOCUMENTATION_URL="https://github.com/regnermax45-art/maxregnerOS-manifest"
LOGO="maxregneros"
ANSI_COLOR="1;36"
UBUNTU_CODENAME="@BASECODENAME"' > /etc/os-release
